# Database Configuration (SHARED with Frontend)
DATABASE_URL="postgresql://user:password@localhost:5432/finnegans_chatbots?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/finnegans_chatbots"

# Meta WhatsApp Webhook Security
# IMPORTANT: These are for webhook verification only. User-specific credentials
# (Access Token, Phone Number ID, Business Account ID) are stored in the database per user.
META_VERIFY_TOKEN="your-webhook-verify-token"
META_APP_SECRET="your-app-secret-from-meta-dashboard"

# Server Configuration
# The server runs on a single port for both HTTP and WebSocket
PORT=3000

# Frontend URL for CORS (WebSocket)
FRONTEND_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Optional: JWT Secret for authentication (if needed)
JWT_SECRET="your-jwt-secret-here"
